msgid "カプセルの発射スイッチや通信機などです。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x19"
msgid "何も、表示されていません。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1A"
msgid "ドアが開きません。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1B"
msgid "「わぁ、何これ!ムッチャクチャ、せまいじゃない!」と、ふへいを言っています。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1C"
msgid "「名前? エリカよ!なんべん言ったらわかんの⁉」"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1D"
msgid "エリカの、大きなおしりがあります。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1E"
msgid "「こんなせまいとこで、そんな物、ふりまわさないでよ!」と、エリカが言っていますが・・・"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x1F"
msgid "バーン‼ 「なんてことすんのよ、危ないじゃない! バカ!」と、エリカにしかられてしまいました。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x20"
msgid "「そんなことしてないで、早くカプセルを発射してよ!」と、言っていますが・・・"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x21"
msgid "「あっ、ああ・・ん」"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x22"
msgid "「ふざけていないで、早くスイッチを入れてよ!」と、言っていますが・・・"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x23"
msgid "OK! 体をぶつけても、痛くないようにできています。手が痛くありません。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x24"
msgid "「痛いなぁ!そんなことしてないで、早くボタンをおしてよ!」と、エリカは言っています。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x25"
msgid "「せまいんだから、ウロチョロしないでよ!」と、エリカにしかられてしまいました。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x26"
msgid "形のいい、大きなおしりです。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x27"
msgid "キュッ!と引きしまっています。"
msgstr ""

#. Salle 55
msgctxt "salle 55 0x28"
msgid "敵の兵士用ユニフォームです。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x10"
msgid "「ああっ・・・好きよ、好き・・・」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x11"
msgid "どっかーん‼ ああ、すっきりした。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x12"
msgid "こんな時、そんなことをしないでください。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x13"
msgid "「ああっ、そんな物、早くしまってょ・・・」と、エリカは言っています。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x14"
msgid "「ああーん、早く逃げないと、爆発しちゃうー!」と、言っています。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x15"
msgid "ドアが開きません。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x16"
msgid "「エ、エリカ・・よ・・・」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x17"
msgid "なかなか、形のいいオッパイです。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x18"
msgid "かわいいおへそです。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x19"
msgid "かわいい、おま( )こです。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1A"
msgid "「あっ、痛いじゃない!何すんのよ‼」と、エリカはおこっています。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1B"
msgid "「ああっ!やめて‼」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1C"
msgid "「やめて、見ないで・・・はずかしいわ・・・」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1D"
msgid "「あっ、もうやめちゃうの?だめねえ・・・」と、エリカはもの足りなさそうですが・・・"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1E"
msgid "「あっ!そこは・・・!」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x1F"
msgid "「いやあ!はずかしい!」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x20"
msgid "いつでも発射可能です。早く逃げましょう。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x21"
msgid "きれいな足をしています。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x22"
msgid "プリプリした、おしりです。"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x23"
msgid "「あっ、ああっー! いい! 気持ちいい‼」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x24"
msgid "「ああ・・・ん」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x25"
msgid "「あうっ!  うっ!」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x26"
msgid "「ああっ・・こんなの、初めてよぉ・・・」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x27"
msgid "「あっ! そこ、そこよ‼」"
msgstr ""

#. Salle 56
msgctxt "salle 56 0x28"
msgid "「あっ・・・ああ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x10"
msgid "「もっ、もうやめて! おかしくなっちゃうわ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x11"
msgid "「ああっ、もっと強く、強くしてぇ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x12"
msgid "「ああっ!もうゆるしてぇ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x13"
msgid "「あっ!もう死にそうよ・・・ああ!」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x14"
msgid "「ずっと、こうしていたいわ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x15"
msgid "「あっ、あああ・・・やめないで・・・」 エリカはふまんそうですが・・・"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x16"
msgid "「あっ、そんなに、いじりまわさないでぇ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x17"
msgid "快感のためか、苦しがっているようにも見えますが・・・"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x18"
msgid "「ああーーっ!」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x19"
msgid "「ああ・・・ん」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1A"
msgid "「ああーっ、あっ! あーー‼」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1B"
msgid "「あううっ!うっ、ああーー!」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1C"
msgid "ドッカーン! ああっ、すっきりした。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1D"
msgid "もうすでに、グッチョングッチョンです。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1E"
msgid "もうすでに、ズルズルのベチョベチョです。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x1F"
msgid "できません。もっと、マジメにやってください。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x20"
msgid "「ああっ・・・名前なんか、どうだっていいわ・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x21"
msgid "「は、早く逃げなくちゃ・・・」と、言っていますが・・・"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x22"
msgid "「あうっ!い、いたい‼」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x23"
msgid "「そんな物いらない・・・それより早く・・・」"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x24"
msgid "いつでも、発射可能です。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x25"
msgid "ドアが開かないので、できません。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x26"
msgid "はなの穴は、かなりひろがっています。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x27"
msgid "こうふんして、ボッ起しています。"
msgstr ""

#. Salle 57
msgctxt "salle 57 0x28"
msgid "そんなことをしているヒマはありません!爆発の時がせまっています。"
msgstr ""

#. Salle 58
msgctxt "salle 58 0x10"
msgid "脱出カプセルは、あなたとエリカを乗せて発射されました。"
msgstr ""

#. Salle 59
msgctxt "salle 59 0x10"
msgid "敵基地は、大爆発を起こして、消滅しました。"
msgstr ""

#. Salle 59
msgctxt "salle 59 0x11"
msgid "脱出がおくれて、あなたとエリカは、敵基地の爆発にまき込まれてしまいました。"
msgstr ""

#. Salle 60
msgctxt "salle 60 0x10"
msgid "あなたは、みごとに任務を果たしました!おめでとう‼"
msgstr ""

#. Salle 60
msgctxt "salle 60 0x11"
msgid "エリカは、あなたが抱いてくれなかったので、爆弾をセットしませんでした。"
msgstr ""

#. Salle 60
msgctxt "salle 60 0x12"
msgid "従って、あなたは敵基地の爆破に、しっぱいしてしまいました。女心はわかりませんね・・・"
msgstr ""

